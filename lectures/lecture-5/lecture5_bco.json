  "usability_domain": [
    "Demonstrates a variant calling pipeline for BIOC 6223 (Introduction to",
    " Bioinformatics) at The George Washington University.",
    "Covers the full conceptual pipeline from raw FASTQ reads through quality",
    " control, alignment, and variant calling to VCF output. Includes a live ",
    " Python walkthrough parsing a synthetic VCF file to illustrate reading, ",
    "filtering, and classifying variants by type (SNP, INS, DEL). Intended as ",
    " a companion BCO to the lecture walkthrough, illustrating how a pipeline ",
    "maps onto BCO domains (description_domain, execution_domain, io_domain)."
  ],
  "description_domain": {
    "keywords": [
      "variant calling",
      "VCF",
      "SNP",
      "indel",
      "bioinformatics pipeline",
      "reproducibility",
      "Python",
      "BWA",
      "GATK",
      "BioCompute Object"
    ],
    "platform": ["Linux"],
    "pipeline_steps": [
      {
        "step_number": 1,
        "name": "Quality Control",
        "description": "Assess raw sequencing read quality with FastQC and trim low-quality bases and adapter sequences with Trim Galore.",
        "version": "0.11.9",
        "prerequisite": [],
        "input_list": [
          {
            "uri": "file://input/reads.fastq.gz",
            "access_time": "2026-09-17T00:00:00.000Z"
          }
        ],
        "output_list": [
          {
            "uri": "file://output/reads_trimmed.fastq.gz",
            "access_time": "2026-09-17T00:00:00.000Z"
          },
          {
            "uri": "file://output/fastqc_report.html",
            "access_time": "2026-09-17T00:00:00.000Z"
          }
        ]
      },
      {
        "step_number": 2,
        "name": "Read Alignment",
        "description": "Align trimmed reads to the reference genome with BWA-MEM; sort and index the resulting BAM file with SAMtools.",
        "version": "0.7.17",
        "prerequisite": [
          {
            "name": "Quality Control",
            "uri": {
              "uri": "file://output/reads_trimmed.fastq.gz"
            }
          }
        ],
        "input_list": [
          {
            "uri": "file://output/reads_trimmed.fastq.gz"
          },
          {
            "uri": "file://input/synthetic_chr1_100bp.fa"
          }
        ],
        "output_list": [
          {
            "uri": "file://output/aligned_sorted.bam"
          },
          {
            "uri": "file://output/aligned_sorted.bam.bai"
          }
        ]
      },
      {
        "step_number": 3,
        "name": "Variant Calling",
        "description": "Call SNPs and indels from aligned reads with GATK HaplotypeCaller. Apply quality and depth filters: QUAL < 20 flagged LowQual; DP < 10 flagged LowDepth.",
        "version": "4.5.0.0",
        "prerequisite": [
          {
            "name": "Read Alignment",
            "uri": {
              "uri": "file://output/aligned_sorted.bam"
            }
          }
        ],
        "input_list": [
          {
            "uri": "file://output/aligned_sorted.bam"
          },
          {
            "uri": "file://input/synthetic_chr1_100bp.fa"
          }
        ],
        "output_list": [
          {
            "uri": "file://output/synthetic_variants.vcf"
          }
        ]
      },
      {
        "step_number": 4,
        "name": "VCF Parsing and Filtering",
        "description": "Parse the VCF with Python: separate meta-information, column header, and data lines; retain PASS variants only; classify each as SNP, INS, or DEL.",
        "version": "3.11",
        "prerequisite": [
          {
            "name": "Variant Calling",
            "uri": {
              "uri": "file://output/synthetic_variants.vcf"
            }
          }
        ],
        "input_list": [
          {
            "uri": "file://output/synthetic_variants.vcf"
          }
        ],
        "output_list": [
          {
            "uri": "file://output/pass_variants_summary.txt"
          }
        ]
      }
    ]
  },
